{
  "name": "dota2-grid-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1 --port 3001 --strictPort\" \"wait-on http://127.0.0.1:3001 && electron .\"",
    "desktop:build": "vite build && electron-builder --win zip"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.5.1"
  },
  "productName": "Dota Grid Studio",
  "main": "electron/main.cjs",
  "build": {
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "createDesktopShortcut": true,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "target": [
        "zip"
      ]
    },
    "appId": "com.parallelseams.dota2gridstudio",
    "productName": "Dota Grid Studio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "description": "Windows desktop editor for Dota 2 hero grid layouts",
  "author": "ParallelSeams"
}
